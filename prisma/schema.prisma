generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Court {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  price     Int
  isAvailable Boolean   @default(true)
  openTime    String   @default("08:00")
  closeTime   String   @default("22:00")
  bookings  Booking[]
  closures  CourtClosure[]
}

model Booking {
  id           String   @id @default(uuid())
  customerName String
  phoneNumber  String
  date         DateTime
  startTime    String
  status       String   @default("PENDING")
  slipUrl      String?  @db.LongText
  price        Int
  createdAt    DateTime @default(now())
  courtId      Int
  court        Court    @relation(fields: [courtId], references: [id])

  @@index([date])
  @@index([status])
  @@index([createdAt])
  @@index([courtId])
  @@index([phoneNumber])
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model CourtClosure {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  courtId   Int
  court     Court    @relation(fields: [courtId], references: [id])

  @@index([courtId])
}

model CourtRule {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  orderNumber Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderNumber])
  @@index([isActive])
}

model PaymentSetting {
  id          Int      @id @default(1)
  promptPayId String   @default("0640388696")
  accountName String   @default("")
  bankName    String   @default("")
  updatedAt   DateTime @updatedAt
}

model ContactSetting {
  id           Int      @id @default(1)
  phoneNumber  String   @default("064-038-8696")
  openTime     String   @default("")
  lineId       String   @default("@SantiphapBad")
  lineUrl      String   @default("https://line.me/R/ti/p/@915avwsq")
  facebookName String   @default("")
  facebookUrl  String   @default("https://www.facebook.com/profile.php?id=100069056293502")
  updatedAt    DateTime @updatedAt
}

model SiteProfileSetting {
  id             Int      @id @default(1)
  siteName       String   @default("")
  slogan         String   @default("")
  description    String   @default("")
  logoUrl        String   @db.Text
  heroImageUrl   String   @db.Text
  aboutTitle     String   @default("")
  aboutDesc      String   @default("") @db.VarChar(1000)
  aboutFeature1  String   @default("")
  aboutFeature2  String   @default("")
  aboutFeature3  String   @default("")
  aboutImage1Url String   @db.Text
  aboutImage2Url String   @db.Text
  rulesImageUrl  String   @db.Text
  updatedAt      DateTime @updatedAt
}



